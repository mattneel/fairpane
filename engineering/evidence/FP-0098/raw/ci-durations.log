
COMMAND ["C:\\nvm4w\\nodejs\\node.EXE","-e","\nconst { execFileSync } = require(\"child_process\");\nconst gh = process.argv[1];\nconst runs = JSON.parse(execFileSync(gh, [\"run\",\"list\",\"--workflow\",\"Gates\",\"--limit\",\"60\",\"--json\",\"databaseId,headSha,status,conclusion,createdAt,attempt\"], { encoding: \"utf8\" }));\nfor (const run of runs) {\n  if (run.status !== \"completed\") { console.log(`${run.databaseId} ${run.headSha.slice(0,7)} ${run.createdAt} ${run.status}`); continue; }\n  const view = JSON.parse(execFileSync(gh, [\"run\",\"view\",String(run.databaseId),\"--json\",\"jobs,attempt\"], { encoding: \"utf8\" }));\n  for (const job of view.jobs) for (const st of job.steps) {\n    if (st.name !== \"Run gate zig-test\" || !st.startedAt || !st.completedAt) continue;\n    const s = Math.round((Date.parse(st.completedAt) - Date.parse(st.startedAt)) / 1000);\n    console.log(`${run.databaseId} attempt ${view.attempt} ${run.headSha.slice(0,7)} created ${run.createdAt} ${job.name} zig-test ${st.conclusion} ${s}s`);\n  }\n}\n","C:\\Program Files\\GitHub CLI\\gh.exe"]
