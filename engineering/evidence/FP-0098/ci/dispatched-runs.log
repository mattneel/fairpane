
COMMAND ["C:\\nvm4w\\nodejs\\node.EXE","-e","\nconst { execFileSync } = require(\"child_process\");\nconst gh = process.argv[1], head = process.argv[2];\nconst runs = JSON.parse(execFileSync(gh, [\"run\", \"list\", \"--workflow\", \"Gates\", \"--event\", \"workflow_dispatch\", \"--limit\", \"50\", \"--json\", \"databaseId,headSha,status,conclusion,createdAt,attempt\"], { encoding: \"utf8\" }))\n  .filter(r => r.headSha === head).sort((a, b) => a.databaseId - b.databaseId);\nconst secs = s => (Date.parse(s.completedAt) - Date.parse(s.startedAt)) / 1000;\nlet max = { Windows: 0, Linux: 0 }, allPass = true;\nfor (const r of runs) {\n  const v = JSON.parse(execFileSync(gh, [\"run\", \"view\", String(r.databaseId), \"--json\", \"databaseId,headSha,event,status,conclusion,attempt,createdAt,updatedAt,jobs\"], { encoding: \"utf8\" }));\n  const row = { run: v.databaseId, head: v.headSha, event: v.event, attempt: v.attempt, status: v.status, conclusion: v.conclusion, jobs: {} };\n  for (const j of v.jobs) {\n    const os = j.name.split(\" \")[0];\n    const steps = Object.fromEntries(j.steps.filter(s => s.name.startsWith(\"Run gate \")).map(s => [s.name.slice(9), { seconds: secs(s), conclusion: s.conclusion }]));\n    row.jobs[os] = { conclusion: j.conclusion, seconds: secs(j), gates: steps };\n    if (steps[\"zig-test\"]) max[os] = Math.max(max[os], steps[\"zig-test\"].seconds);\n  }\n  if (v.conclusion !== \"success\") allPass = false;\n  console.log(JSON.stringify(row));\n}\nconsole.log(JSON.stringify({ summary: { head, runs: runs.length, all_success: allPass, slowest_zig_test_seconds: max, limit_seconds: 400 } }));\n","C:\\Program Files\\GitHub CLI\\gh.exe","29a9f8e1cc1dde5e249226f6b2237e8387493f88"]
