//! FP-0011 revision 1 probe: does `@typeInfo(T).@"struct".decl_names` list declarations without `pub`?

const Local = struct {
    pub fn public_function() void {}
    fn private_function() void {}
    const private_constant = 1;
    pub const public_constant = 2;
};

fn render(comptime T: type) []const u8 {
    comptime {
        var text: []const u8 = "";
        for (@typeInfo(T).@"struct".decl_names) |name| text = text ++ " " ++ name;
        return text;
    }
}

