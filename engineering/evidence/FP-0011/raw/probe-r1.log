//! FP-0011 revision 1 probe: what does bindKernels report for a kernel declared without `pub`?

const js = @import("fairpane").js;
const Rt = js.Runtime(.reference);

const Kernels = struct {
    fn number_add(ctx: *Rt.Context(.{}), x: f64, y: f64) f64 {
        _ = ctx;
        return x + y;
    }
};

comptime {
    _ = Rt.bindKernels(js.operations.catalog[0..1], Kernels);
}
