COMMAND ["C:\\Program Files\\Git\\usr\\bin\\cat.exe","out/fp0011-r1-overlay/make-overlay.mjs"]
// FP-0011 revision 1: writes the case 38 test additions over the revision base's number files.
// Usage: node make-overlay.mjs <base-commit> <output-directory>
// The output holds the base's src/js/number.zig and src/js/number_vectors.zig with exactly the
// case 38 vectors and test of the working tree appended, and nothing else changed.
import { execFileSync } from 'node:child_process';
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const [base, output] = process.argv.slice(2);
if (!base || !output) throw new Error('Usage: node make-overlay.mjs <base-commit> <output-directory>');

function cut(text, start, end) {
  const from = text.indexOf(start);
  if (from < 0) throw new Error(`missing ${JSON.stringify(start)}`);
  const to = end === undefined ? text.length : text.indexOf(end, from);
  if (to < 0) throw new Error(`missing ${JSON.stringify(end)}`);
  return text.slice(from, to);
}

const show = (path) => execFileSync('git', ['show', `${base}:${path}`], { encoding: 'utf8' });

const testBlock = cut(readFileSync('src/js/number.zig', 'utf8'), '\ntest "FP-0011 case 38');
const vectorBlock = cut(readFileSync('src/js/number_vectors.zig', 'utf8'), '\n/// A literal of `prefix`', '\nfn matches(');

const baseNumber = show('src/js/number.zig');
const baseVectors = show('src/js/number_vectors.zig');
const anchor = baseVectors.indexOf('\nfn matches(');
if (anchor < 0) throw new Error('missing fn matches in the base vectors');

mkdirSync(join(output, 'src', 'js'), { recursive: true });
writeFileSync(join(output, 'src', 'js', 'number.zig'), baseNumber + testBlock);
writeFileSync(join(output, 'src', 'js', 'number_vectors.zig'), baseVectors.slice(0, anchor) + vectorBlock + baseVectors.slice(anchor));
