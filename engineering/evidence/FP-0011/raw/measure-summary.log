
COMMAND ["C:\\Program Files\\Git\\usr\\bin\\cat.exe","out/fp0011-summary.js"]
const fs = require('fs');
const reps = ['reference', 'nan_box', 'tagged_index'];
const runs = ['run1', 'run2'];
const workloads = ['add-small-int', 'add-fraction', 'get-prototype-chain', 'number-to-string', 'object-churn', 'mark-generated', 'mark-manual'];
const data = {};
for (const r of reps) for (const run of runs) {
  const lines = fs.readFileSync(`engineering/evidence/FP-0011/raw/measure-${r}-${run}.log`, 'utf8').split(/\r?\n/).filter(l => l.startsWith('{'));
  const header = JSON.parse(lines[0]);
  const samples = lines.slice(1).map(l => JSON.parse(l));
  const result = JSON.parse(fs.readFileSync(`engineering/evidence/FP-0011/raw/measure-${r}-${run}.log`, 'utf8').split(/\r?\n/).find(l => l.startsWith('RESULT ')).slice(7));
  data[`${r}/${run}`] = { header, samples, exit: result.exit_code };
}
const stats = {};
for (const key of Object.keys(data)) {
  const d = data[key];
  console.log(`HEADER ${key} exit=${d.exit} ${JSON.stringify(d.header)}`);
  for (const w of workloads) {
    const measured = d.samples.filter(s => s.workload === w && !s.warmup);
    const ns = measured.map(s => s.ns).sort((a, b) => a - b);
    const checksums = [...new Set(d.samples.filter(s => s.workload === w).map(s => JSON.stringify(s.checksum)))];
    const peak = [...new Set(measured.map(s => s.peak_live_bytes))];
    const cells = [...new Set(measured.map(s => s.cells_allocated))];
    const collections = [...new Set(measured.map(s => s.collections))];
    stats[`${key}/${w}`] = { min: ns[0], median: ns[5], max: ns[10] };
    console.log(`STATS ${key} ${w} n=${ns.length} min=${ns[0]} median=${ns[5]} max=${ns[10]} checksums=${checksums.join(',')} peak_live_bytes=${peak.join(',')} cells_allocated=${cells.join(',')} collections=${collections.join(',')}`);
  }
}
function compare(a, b, w) {
  const verdicts = runs.map(run => {
    const x = stats[`${a}/${run}/${w}`], y = stats[`${b}/${run}/${w}`];
    if (x.max < y.min) return 'faster';
    if (y.max < x.min) return 'slower';
    return 'overlap';
  });
  return verdicts[0] === verdicts[1] && verdicts[0] !== 'overlap' ? verdicts[0] : `not separable (${verdicts.join('/')})`;
}
const six = workloads.slice(0, 6);
for (const [a, b] of [['nan_box', 'reference'], ['tagged_index', 'reference'], ['nan_box', 'tagged_index']]) {
  for (const w of six) console.log(`PAIR ${a} vs ${b} ${w}: ${a} ${compare(a, b, w)}`);
}
for (const r of reps) {
  const verdicts = runs.map(run => {
    const g = stats[`${r}/${run}/mark-generated`], m = stats[`${r}/${run}/mark-manual`];
    if (g.max < m.min) return 'faster';
    if (m.max < g.min) return 'slower';
    return 'overlap';
  });
  const v = verdicts[0] === verdicts[1] && verdicts[0] !== 'overlap' ? verdicts[0] : `not separable (${verdicts.join('/')})`;
  console.log(`TRACER ${r} mark-generated vs mark-manual: generated ${v}`);
}
