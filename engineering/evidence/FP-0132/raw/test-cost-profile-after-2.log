      const file = line.slice(5), target = path.join(toolchain, ...file.split('/')), parent = path.dirname(target);
      if (!made.has(parent)) { fs.mkdirSync(parent, { recursive: true }); made.add(parent); }
      fs.renameSync(path.join(dir, ...file.split('/')), target);
    }
  }
}
const t = { subtree: 0, subtreeRm: 0, perFile: 0, perFileRm: 0 };
const N = 30;
for (let k = 0; k < N; k++) {
  for (const mode of k % 2 ? ['perFile', 'subtree'] : ['subtree', 'perFile']) {
