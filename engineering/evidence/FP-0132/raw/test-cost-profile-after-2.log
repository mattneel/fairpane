// The per-file strategy of the first reduction: one mkdir per new parent and one rename per listed file.
function perFile(extracted, root, toolchain) {
  const b = path.join(extracted, root);
  for (const component of fs.readFileSync(path.join(b, 'components'), 'utf8').split('\n').filter(Boolean)) {
    const dir = path.join(b, component), made = new Set();
    fs.readFileSync(path.join(b, 'rust-installer-version'), 'utf8');
    const walk = d => { for (const e of fs.readdirSync(d, { withFileTypes: true })) if (e.isDirectory()) walk(path.join(d, e.name)); };
    walk(dir);
    for (const line of fs.readFileSync(path.join(dir, 'manifest.in'), 'utf8').split('\n').filter(Boolean)) fs.lstatSync(path.join(dir, ...line.slice(5).split('/')));
