    fs.mkdirSync(tc);
    for (const [i, a] of archives.entries()) await extractTarGz(path.join('out/fp0132/arch', a), a.replace('.tar.gz', ''), path.join(stage, String(i)));
    let s = performance.now();
    const installed = new Set();
    for (const [i, a] of archives.entries()) {
      if (mode === 'subtree') installComponents(path.join(stage, String(i)), a.replace('.tar.gz', ''), tc, installed);
      else perFile(path.join(stage, String(i)), a.replace('.tar.gz', ''), tc);
    }
    t[mode] += performance.now() - s;
    fs.renameSync(tc, path.join(base, `${mode}-${k}`));
    s = performance.now(); fs.rmSync(stage, { recursive: true, force: true }); t[`${mode}Rm`] += performance.now() - s;
  }
}
