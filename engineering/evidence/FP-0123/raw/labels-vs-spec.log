const fs = require('fs');
const crypto = require('crypto');
const [specPath, zigPath] = process.argv.slice(2);
const spec = fs.readFileSync(specPath);
console.log('encoding.bs sha256 ' + crypto.createHash('sha256').update(spec).digest('hex'));
const lines = spec.toString('utf8').split('\n');
const start = lines.findIndex(l => l.startsWith('<h3 id=names-and-labels>'));
const tableStart = lines.findIndex((l, i) => i > start && l.startsWith('<table>'));
const tableEnd = lines.findIndex((l, i) => i > tableStart && l.startsWith('</table>'));
const fromSpec = [];
for (const line of lines.slice(tableStart, tableEnd)) {
  const name = line.match(/<a>([^<]+)<\/a>/);
  if (name && !line.includes('href=')) fromSpec.push({ name: name[1], labels: [] });
  for (const m of line.matchAll(/"<code>([^<]+)<\/code>"/g)) fromSpec[fromSpec.length - 1].labels.push(m[1]);
}
const fromZig = [];
for (const m of fs.readFileSync(zigPath, 'utf8').matchAll(/\.name = "([^"]+)", \.labels = &\.\{([^}]*)\}/g)) {
  fromZig.push({ name: m[1], labels: [...m[2].matchAll(/"([^"]+)"/g)].map(x => x[1]) });
}
const count = t => t.reduce((n, e) => n + e.labels.length, 0);
console.log(JSON.stringify({
  spec_names: fromSpec.length, spec_labels: count(fromSpec),
  zig_names: fromZig.length, zig_labels: count(fromZig),
  identical: JSON.stringify(fromSpec) === JSON.stringify(fromZig),
}));
process.exitCode = JSON.stringify(fromSpec) === JSON.stringify(fromZig) ? 0 : 1;
