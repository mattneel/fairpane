RESULT {"executable":"C:\\nvm4w\\nodejs\\node.EXE","arguments":["-e","\nconst { execFileSync } = require(\"child_process\");\nconst gh = process.argv[1], since = process.argv[2];\nconst runs = JSON.parse(execFileSync(gh, [\"run\", \"list\", \"--workflow\", \"Gates\", \"--limit\", \"300\", \"--json\", \"databaseId,headSha,event,status,conclusion,createdAt,attempt\"], { encoding: \"utf8\" }))\n  .filter(r => r.createdAt >= since).sort((a, b) => a.databaseId - b.databaseId);\nconst secs = s => (s.startedAt && s.completedAt) ? (Date.parse(s.completedAt) - Date.parse(s.startedAt)) / 1000 : null;\nconst failed = [];\nfor (const r of runs) {\n  for (let k = 1; k <= r.attempt; k++) {\n    const v = JSON.parse(execFileSync(gh, [\"run\", \"view\", String(r.databaseId), \"--attempt\", String(k), \"--json\", \"databaseId,headSha,event,status,conclusion,attempt,createdAt,jobs\"], { encoding: \"utf8\" }));\n    const row = { run: v.databaseId, attempt: k, head: v.headSha, event: v.event, created: r.createdAt, status: v.status, conclusion: v.conclusion, jobs: {} };\n    for (const j of v.jobs) {\n      const gates = {};\n      for (const s of j.steps) if (s.name.startsWith(\"Run gate \")) gates[s.name.slice(9)] = [secs(s), s.conclusion];\n      row.jobs[j.name.split(\" \")[0]] = { conclusion: j.conclusion, gates };\n    }\n    if (v.status === \"completed\" && v.conclusion !== \"success\") failed.push({ run: v.databaseId, attempt: k, head: v.headSha.slice(0, 7), failing: Object.entries(row.jobs).flatMap(([os, j]) => Object.entries(j.gates).filter(([, g]) => g[1] === \"failure\").map(([n, g]) => `${os} ${n} ${g[0]}s`)) });\n    console.log(JSON.stringify(row));\n  }\n}\nconsole.log(JSON.stringify({ summary: { since, runs: runs.length, failed_attempts: failed } }));\n","C:\\Program Files\\GitHub CLI\\gh.exe","2026-10-09T13:00:00Z"],"cwd":"C:\\src\\fairpane","started_at":"2026-10-09T15:59:54.612Z","exit_code":0,"signal":null,"timed_out":false,"error":null,"duration_ms":223559}
