+        try testing.expect((try run.drainOne()).kind != @backingInt(abi.EventKind.none));
+        if (!try run.reloadAtLimit(spare)) {
+            try testing.expect((try run.drainOne()).kind != @backingInt(abi.EventKind.none));
+            try testing.expect(try run.reloadAtLimit(spare));
+        }
+    }
+};
