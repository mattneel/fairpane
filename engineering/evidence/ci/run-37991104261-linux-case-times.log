
COMMAND ["C:\\nvm4w\\nodejs\\node.EXE","-e","\nconst fs = require('fs');\nconst read = file => { const d = new Map(); for (const l of fs.readFileSync(file, 'utf8').split('\\n')) { const m = /^# duration_ms (\\d+) (\\d+)$/.exec(l); if (m) d.set(+m[1], +m[2]); } return d; };\nconst names = file => fs.readFileSync(file, 'utf8').split('\\n').map(l => /^(?:not )?ok (\\d+) - (.*)$/.exec(l)).filter(Boolean).map(m => [+m[1], m[2]]);\nconst [slow, normal] = process.argv.slice(1);\nconst ds = read(slow), dn = read(normal), ns = new Map(names(slow).map(([i, n]) => [n, i])), nn = new Map(names(normal).map(([i, n]) => [n, i]));\nconst pairs = [];\nfor (const [name, i] of ns) if (nn.has(name)) { const a = ds.get(i), b = dn.get(nn.get(name)); if (a !== undefined && b !== undefined) pairs.push({ name, slow: a, normal: b }); }\nconst sum = k => pairs.reduce((s, p) => s + p[k], 0);\nconst big = pairs.filter(p => p.normal >= 200).map(p => p.slow / p.normal).sort((x, y) => x - y);\nconst q = f => big[Math.min(big.length - 1, Math.floor(f * big.length))];\nconsole.log(JSON.stringify({ slow, normal, shared_cases: pairs.length, slow_sum_ms: sum('slow'), normal_sum_ms: sum('normal'), ratio_of_sums: +(sum('slow') / sum('normal')).toFixed(2), cases_at_least_200ms_in_normal: big.length, ratio_quartiles: [q(0.25), q(0.5), q(0.75)].map(x => +x.toFixed(2)), ratio_min: +big[0].toFixed(2), ratio_max: +big[big.length - 1].toFixed(2) }, null, 1));\n","engineering/evidence/ci/run-37991104261-attempt-1/linux-gate-receipts-unsigned-local-integrity-records-not-attestations/2026-10-09T21-04-46-883Z-controller-test-65282178.log","engineering/evidence/ci/run-37978329724/linux-gate-receipts-unsigned-local-integrity-records-not-attestations/2026-10-09T19-10-13-757Z-controller-test-4ba57292.log"]
