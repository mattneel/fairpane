
COMMAND ["C:\\nvm4w\\nodejs\\node.EXE","-e","\nconst { execFileSync } = require(\"child_process\");\nconst gh = process.argv[1], since = process.argv[2], until = process.argv[3];\nconst runs = JSON.parse(execFileSync(gh, [\"run\", \"list\", \"--workflow\", \"Gates\", \"--limit\", \"300\", \"--json\", \"databaseId,headSha,event,status,conclusion,createdAt,attempt\"], { encoding: \"utf8\" }))\n  .filter(r => r.createdAt >= since && r.createdAt <= until).sort((a, b) => a.databaseId - b.databaseId);\nconst secs = s => (s.startedAt && s.completedAt) ? (Date.parse(s.completedAt) - Date.parse(s.startedAt)) / 1000 : null;\nconst failed = [];\nfor (const r of runs) {\n  for (let k = 1; k <= r.attempt; k++) {\n    const v = JSON.parse(execFileSync(gh, [\"run\", \"view\", String(r.databaseId), \"--attempt\", String(k), \"--json\", \"databaseId,headSha,headBranch,event,status,conclusion,attempt,jobs\"], { encoding: \"utf8\" }));\n    const row = { run: v.databaseId, attempt: k, head: v.headSha, branch: v.headBranch, event: v.event, created: r.createdAt, status: v.status, conclusion: v.conclusion, jobs: {} };\n    for (const j of v.jobs) { const g = {}; for (const s of j.steps) if (s.name.startsWith(\"Run gate \")) g[s.name.slice(9)] = [secs(s), s.conclusion]; row.jobs[j.name.split(\" \")[0]] = { conclusion: j.conclusion, gates: g }; }\n    if (v.status !== \"completed\" || v.conclusion !== \"success\") failed.push({ run: v.databaseId, attempt: k, head: v.headSha.slice(0, 7), status: v.status, conclusion: v.conclusion, failing: Object.entries(row.jobs).flatMap(([os, j]) => Object.entries(j.gates).filter(([, g]) => g[1] !== \"success\").map(([n, g]) => `${os} ${n} ${g[1]} ${g[0]}s`)) });\n    console.log(JSON.stringify(row));\n  }\n}\nconsole.log(JSON.stringify({ summary: { since, until, runs: runs.length, not_success: failed } }));\n","C:\\Program Files\\GitHub CLI\\gh.exe","2026-10-09T20:44:08Z","2026-10-09T21:02:54Z"]
