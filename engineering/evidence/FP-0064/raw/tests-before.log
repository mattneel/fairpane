+// FP-0064 tests-before run 2: the CDATA cases through the base helper `tokenizeChunksForeign`.
+
+const fp0064_cdata_cases = [_]Case{
+    .{ .id = "K1", .input = "<![CDATA[x", .expected = "C\"x\" !eof-in-cdata@1:11 EOF" },
+    .{ .id = "CD1", .input = "<![CDATA[a]b]]c]]]>d", .expected = "C\"a]b]]c]d\" EOF" },
+    .{ .id = "CD2", .input = "<![CDATA[\\0\\u0001]", .expected = "C\"\\u0000\" !control-character-in-input-stream@1:11 C\"\\u0001]\" !eof-in-cdata@1:13 EOF" },
+    .{ .id = "CD3", .input = "<![CDATA[]]", .expected = "C\"]]\" !eof-in-cdata@1:12 EOF" },
+    .{ .id = "CD4", .input = "<![CDATA[]]>", .expected = "EOF" },
+    .{ .id = "CD5", .input = "<![CDATA[<a>&amp;</a>]]><b>", .expected = "C\"<a>&amp;</a>\" S\"b\"[] EOF" },
+    .{ .id = "CD6", .input = "<!--a--><![CDATA[", .expected = "M\"a\" !eof-in-cdata@1:18 EOF" },
+    .{ .id = "Q9", .input = "<![CDATA[a]]]>", .expected = "C\"a]\" EOF" },
+    .{ .id = "Q10", .input = "<![CDATA[]\\0]", .expected = "C\"]\\u0000]\" !eof-in-cdata@1:13 EOF" },
+    .{ .id = "Q11", .input = "<![CDATA[\\uD83D\\uDE00]]>", .expected = "C\"\\uD83D\\uDE00\" EOF" },
+    .{ .id = "Q12", .input = "<![CDATA[x]]>", .expected = "C\"x\" EOF" },
+};
+
+test "FP-0064 tests-before run 2: K1, CD1 to CD6, and Q9 to Q12 as one chunk with a foreign adjusted current node" {
+    const gpa = testing.allocator;
+    var first_error: ?anyerror = null;
+    for (fp0064_cdata_cases) |case| {
+        const input = try decodeInput(gpa, case.input);
+        defer gpa.free(input);
+        const expected = try expectedDump(gpa, case.expected);
+        defer gpa.free(expected);
+        const observed = tokenizeChunksForeign(gpa, input, &.{}, dump.plain, true) catch |err| {
+            std.debug.print("FP-0064 case {s}: {s}\n", .{ case.id, @errorName(err) });
+            if (first_error == null) first_error = err;
+            continue;
+        };
+        defer gpa.free(observed);
+        if (!std.mem.eql(u8, expected, observed)) {
+            std.debug.print("FP-0064 case {s}:\nexpected:\n{s}observed:\n{s}", .{ case.id, expected, observed });
+            if (first_error == null) first_error = error.TestExpectedEqual;
+        }
+    }
+    if (first_error) |err| return err;
+}
+
+test "FP-0064 tests-before run 2: case 15 with the flag true, whole and split at offset 6" {
+    const gpa = testing.allocator;
+    const input = asciiUnits("<![CDATA[x]]>");
+    const cdata_dump = "[\"Character\",\"x\",[9,10]]\n[\"EOF\",[13,13]]\n";
+    for ([_][]const usize{ &.{}, &.{6} }) |boundaries| {
+        const observed = try tokenizeChunksForeign(gpa, &input, boundaries, dump.full, true);
+        defer gpa.free(observed);
+        try testing.expectEqualStrings(cdata_dump, observed);
+    }
+}
